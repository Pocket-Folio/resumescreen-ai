# ─────────────────────────────────────────────────────────────
# ResumeScreen AI — configuration
# Copy to .env and fill in. NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────

# Claude API key (server-side only; never sent to the browser).
# Optional here: you can also save it from Settings → Claude API,
# which stores it in DATA_DIR/secrets.json (file mode 600).
# If set here, the environment value takes precedence and the UI field is locked.
ANTHROPIC_API_KEY=

# Default Claude model (can be changed in Settings)
CLAUDE_MODEL=claude-opus-5

# Password HR staff enter to open the app. REQUIRED when NODE_ENV=production
# (e.g. inside Docker) unless ALLOW_UNAUTHENTICATED=true.
APP_PASSWORD=

# Secret used to sign session cookies. Leave empty to auto-generate one
# (persisted to DATA_DIR/secrets.json).
SESSION_SECRET=

# Set to true when the app is served over HTTPS (recommended on EC2 — see README).
COOKIE_SECURE=false

# Only for a machine that is truly local / on an isolated network.
ALLOW_UNAUTHENTICATED=false

# HTTP port the server listens on
PORT=8080

# Where the SQLite database and secrets are stored (mounted as a Docker volume)
DATA_DIR=./data

# Maximum resume upload size in megabytes
MAX_UPLOAD_MB=10

# Used only by docker-compose's optional HTTPS (Caddy) profile
DOMAIN=

# ─── Docker / EC2 ─────────────────────────────────────────────
# Host interface and port the container is published on.
#   Plain HTTP on port 80:   APP_BIND=0.0.0.0  APP_PORT=80
#   Behind the bundled Caddy HTTPS proxy: APP_BIND=127.0.0.1  APP_PORT=8080
APP_BIND=0.0.0.0
APP_PORT=80

# Server-side refusal fallbacks for Claude Opus 5 (see README). Set false to disable.
CLAUDE_REFUSAL_FALLBACKS=true

# Only if your API key is NOT scoped to a workspace: the Claude workspace ID (wrkspc_…).
# Can also be set in Settings → Claude API.
ANTHROPIC_WORKSPACE_ID=
